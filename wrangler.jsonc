
{
  "name": "shimacub-collection",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shimacub-collection-db",
      "database_id": "324bede5-0332-4e8e-974c-6c76617a94ae"
    }
  ],
  "ratelimits": [
    {
      "name": "RECOVERY_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
